# Supabase
SUPABASE_URL=https://eptpgmfupemwtkkqcpiw.supabase.co
# Service role-nyckeln. Används av ingest-pipelinen och av testriggen för att
# läsa tillbaka rader — den publika nyckeln får inte läsa.
SUPABASE_SECRET_KEY=

OPENAI_API_KEY=

# ── End-to-end-test ──────────────────────────────────────────────────────
# Token som låter testriggen märka rader med ar_test. Måste vara samma värde
# som i tabellen public.test_config. Se tests/README.md.
TEST_TOKEN=

# Bara om testerna ska köras mot en Vercel-preview (staging), som är
# SSO-skyddad. Vercel → Project Settings → Deployment Protection →
# Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
